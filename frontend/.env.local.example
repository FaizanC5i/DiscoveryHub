# Copy to frontend/.env.local. Values here are not secret, but .env.local stays out of Git anyway.

# Base URL of the FastAPI backend. Must match the backend's port.
NEXT_PUBLIC_API_URL=http://localhost:8000

# true = use the in-memory mock auth service (no backend needed).
# false = call the real FastAPI backend.
NEXT_PUBLIC_USE_MOCK_AUTH=false
