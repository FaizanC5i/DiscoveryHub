# Copy this file to backend/.env and fill in real values. Never commit .env.
# Every value below is a placeholder.

ENVIRONMENT=development

# Azure SQL (ODBC Driver 18 for SQL Server must be installed on this machine)
DB_SERVER=your-server.database.windows.net
DB_NAME=your-database-name
DB_USER=your-database-user
DB_PASSWORD=your-database-password
DB_DRIVER=ODBC Driver 18 for SQL Server

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace-with-a-random-string-of-at-least-32-characters

FRONTEND_URL=http://localhost:3000

# Leave empty to log reset links in development instead of emailing them.
COOKIE_SECURE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@discoveryhub.local

# Optional rate-limit overrides (slowapi syntax)
LOGIN_RATE_LIMIT=5/minute
FORGOT_PASSWORD_RATE_LIMIT=3/minute
